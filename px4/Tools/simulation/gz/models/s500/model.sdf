<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='s500'>
    <include merge='true'>
      <uri>model://s500_base</uri>
    </include>
    <plugin filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_0_joint</jointName>
      <linkName>rotor_0</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0570</timeConstantUp>
      <timeConstantDown>0.0570</timeConstantDown>
      <maxRotVelocity>1075.33</maxRotVelocity>
      <motorConstant>1.02166e-05</motorConstant>
      <momentConstant>0.013566</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>0</motorNumber>
      <rotorDragCoefficient>0.0</rotorDragCoefficient>
      <rollingMomentCoefficient>0.0</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
